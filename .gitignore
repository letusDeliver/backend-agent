# Dependencies
node_modules/

# Build output
dist/
build/
out-tsc/
.angular/
*.tsbuildinfo

# Test coverage
coverage/

# Playwright
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/playwright/.cache/

# Logs
*.log
npm-debug.log*

# Environment / secrets — never commit these
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.swp

# Runtime task workspaces and lightweight data store are developer-local artifacts.
tasks/*
!tasks/.gitkeep
data/*
!data/.gitkeep
